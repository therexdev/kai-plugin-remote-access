{"manifest":{"schema":1,"apiVersion":2,"id":"kai.remote-access","name":"KAI Remote Access","version":"0.1.1","description":"Connect trusted clients to your local models through a reviewed, authenticated relay session.","entry":"index.html","permissions":["remote-access.read","remote-access.control","remote-access.keys"]},"files":{"app.js":"\"use strict\";\nconst $=id=>document.getElementById(id);let state=null,busy=false,keysSignature=\"\",legacySignature=\"\",modelsSignature=\"\";\nconst banner=window.KaiPluginNotice.attach($(\"notice\"),{focusTarget:()=>$(\"refresh\")});\nlet backgroundFailure=false;\nfunction notice(message,error=false,background=false){backgroundFailure=background;banner.show(message,{error,force:!background});}\nfunction node(tag,text,className){const el=document.createElement(tag);if(text!==undefined)el.textContent=text;if(className)el.className=className;return el;}\nfunction keyCard(key,legacy=false){const card=node(\"div\",undefined,\"card spread\"),info=node(\"div\");info.append(node(\"h3\",key.name));info.append(node(\"small\",legacy?(key.enabled?\"Allowed for remote access\":\"Not allowed remotely\"):\"Remote text inference only\"));const button=node(\"button\",legacy?(key.enabled?\"Remove remote access\":\"Allow remotely\"):\"Revoke\",legacy?\"\":\"danger\");button.disabled=busy;button.addEventListener(\"click\",()=>act(legacy?\"remote.keyAdopt\":\"remote.keyRevoke\",legacy?{id:key.id,enabled:!key.enabled}:{id:key.id},legacy?\"Remote key permissions updated. Start access again when ready.\":\"Key revoked. Remote Access stopped.\"));card.append(info,button);return card;}\nfunction render(){if(!state)return;$(\"privacy\").textContent=state.privacyMode;$(\"state\").textContent=state.state;$(\"state\").classList.toggle(\"connected\",state.state===\"connected\");$(\"headline\").textContent=({off:\"Remote access is off.\",connecting:\"Connecting to your relay…\",connected:\"Your local models are available.\",offline:\"The relay is currently unavailable.\"})[state.state]||\"Remote Access\";$(\"connection-detail\").textContent=state.state===\"offline\"?\"KAI will retry while this window stays open. You can stop at any time.\":state.enabled?\"Only holders of enabled API keys can use the endpoints shown here.\":\"Create or allow a key, then review the connection before starting.\";$(\"endpoint\").value=state.base||\"\";$(\"start\").disabled=busy||state.enabled;$(\"start\").hidden=!!state.enabled;$(\"stop\").hidden=!state.enabled;$(\"stop\").disabled=!state.enabled;$(\"copy-endpoint\").disabled=busy||!state.base;$(\"key-create\").disabled=busy;$(\"rotate\").disabled=busy;$(\"refresh\").disabled=busy;$(\"counts\").textContent=`${state.counts.served} served · ${state.counts.rejected} rejected this session`;\nconst nextKeys=JSON.stringify([state.keys,busy]);if(nextKeys!==keysSignature){keysSignature=nextKeys;const keys=$(\"keys\");keys.replaceChildren(...state.keys.map(k=>keyCard(k)));if(!state.keys.length)keys.append(node(\"p\",\"No remote keys yet.\",\"empty\"));}\nconst nextLegacy=JSON.stringify([state.legacyKeys,busy]);if(nextLegacy!==legacySignature){legacySignature=nextLegacy;const legacy=$(\"legacy-keys\");legacy.replaceChildren(...state.legacyKeys.map(k=>keyCard(k,true)));if(!state.legacyKeys.length)legacy.append(node(\"p\",\"No existing gateway keys were found.\",\"empty\"));}\nconst nextModels=JSON.stringify(state.models);if(nextModels!==modelsSignature){modelsSignature=nextModels;const selected=$(\"models\").value;$(\"models\").replaceChildren(...state.models.map(m=>{const el=node(\"option\",m.label||m.alias);el.value=m.alias;return el;}));if(state.models.some(m=>m.alias===selected))$(\"models\").value=selected;}\n$(\"model-note\").textContent=state.models.length?\"Use the selected model’s API name: \"+$(\"models\").value:\"Install a local model from Core’s Models section before starting.\";}\n\nasync function refresh(){state=await window.kai.call(\"remote.status\",{});render();if(backgroundFailure){banner.clear();backgroundFailure=false;}}\nasync function act(method,input={},success){if(busy)return;busy=true;banner.clear();render();try{const result=await window.kai.call(method,input);if(result.cancelled)notice(\"Canceled. No change was made.\");else if(success)notice(success);await refresh();}catch(error){notice(error.message||\"This action could not complete.\",true);}finally{busy=false;render();}}\n$(\"refresh\").addEventListener(\"click\",()=>act(\"remote.status\"));$(\"start\").addEventListener(\"click\",()=>act(\"remote.start\",{},\"Connecting. The base URL appears after the relay confirms your address.\"));$(\"stop\").addEventListener(\"click\",async()=>{try{await window.kai.call(\"remote.stop\",{});await refresh();notice(\"Remote Access stopped.\");}catch(e){notice(e.message,true);}});$(\"rotate\").addEventListener(\"click\",()=>act(\"remote.rotate\",{},\"Address identity replaced. Start access again to obtain your new URL.\"));$(\"copy-endpoint\").addEventListener(\"click\",()=>act(\"remote.copyEndpoint\",{},\"Base URL copied.\"));$(\"key-form\").addEventListener(\"submit\",event=>{event.preventDefault();act(\"remote.keyCreate\",{name:$(\"key-name\").value.trim()},\"Key copied by Core. Paste it into your trusted client now; the clipboard clears after 60 seconds if unchanged.\");});$(\"models\").addEventListener(\"change\",()=>{$(\"model-note\").textContent=\"Use this model’s API name: \"+$(\"models\").value;});\nrefresh().catch(e=>notice(e.message,true,true));setInterval(()=>{if(!busy)refresh().catch(e=>notice(e.message,true,true));},3000);\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'\"><title>KAI Remote Access</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body>\n<header class=\"workspace-header\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M21 12H3M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 3c-5 5-5 13 0 18 5-5 5-13 0-18\"/></svg><h1>Remote access</h1><span class=\"workspace-caption\" id=\"privacy\">Connecting to Core</span></header>\n<main><div class=\"api-card\">\n<div class=\"page-heading\"><h2>Your OpenAI-compatible API</h2><p class=\"lead\">Point a trusted app at this computer’s local models.</p></div>\n<div id=\"notice\" role=\"status\" aria-live=\"polite\" hidden></div>\n<section class=\"api-section\" aria-labelledby=\"keys-title\"><div class=\"keys-head\"><h3 id=\"keys-title\">API keys</h3></div><p class=\"hint\">Create a key for each trusted client. A key can list installed models and request local text inference while Remote access is on.</p>\n<form class=\"form-row\" id=\"key-form\"><label for=\"key-name\" class=\"sr-only\">Key name</label><input id=\"key-name\" maxlength=\"80\" required placeholder=\"Key name, e.g. My laptop\"><button class=\"primary\" id=\"key-create\" type=\"submit\">Create and copy key</button></form><p class=\"hint\">Core copies the secret once. Save it in your client within 60 seconds; the plugin never receives it.</p><div id=\"keys\" class=\"key-list\"></div>\n</section>\n<section class=\"api-section\" aria-labelledby=\"access-title\"><div class=\"keys-head\"><h3 id=\"access-title\">Remote access</h3><div class=\"switch-controls\"><button class=\"switch\" id=\"start\" type=\"button\" role=\"switch\" aria-checked=\"false\" aria-label=\"Remote access\" title=\"Review and start Remote access\"><span class=\"switch-track\"><span class=\"switch-thumb\"></span></span><span>Off</span></button><button class=\"switch\" id=\"stop\" type=\"button\" role=\"switch\" aria-checked=\"true\" aria-label=\"Remote access\" title=\"Stop access\" disabled hidden><span class=\"switch-track\"><span class=\"switch-thumb\"></span></span><span>On</span></button></div></div>\n<p class=\"hint\">Use your API from anywhere — a phone, a server, another computer. KAI keeps an outbound connection to koinosai.com, with no router setup. Requests are answered by this computer. An enabled API key is required.</p><p class=\"hint\">Remote Access never starts automatically. Closing it or switching Core to Local-Only stops access.</p>\n<div class=\"connection-status\"><span id=\"state\" class=\"pill\">Off</span><div><strong id=\"headline\">Remote access is off.</strong><p class=\"hint\" id=\"connection-detail\">Create or allow a key, then review the connection before starting.</p></div><button id=\"refresh\" type=\"button\" title=\"Check remote connection\">Check connection</button></div>\n<div class=\"endpoint\"><label for=\"endpoint\">OpenAI-compatible base URL<input id=\"endpoint\" readonly placeholder=\"Appears after connecting\"></label><button id=\"copy-endpoint\" type=\"button\" disabled>Copy URL</button></div><p class=\"hint\" id=\"counts\">No requests served this session.</p><p class=\"relay-note\">The relay at koinosai.com receives client API keys, prompts and responses. Give keys only to trusted clients.</p>\n</section>\n<section class=\"api-section\" aria-labelledby=\"client-title\"><h3 id=\"client-title\">Connect a client</h3><p class=\"hint\">Use the base URL above in your client’s OpenAI-compatible provider settings and paste the key you created. Select one of the available local models.</p><label for=\"models\">Available local models</label><select id=\"models\"></select><p class=\"hint\" id=\"model-note\"></p><details class=\"advanced\"><summary>Supported requests</summary><p class=\"hint\">Text chat only. Up to 16,000 characters of conversation and 4,096 output tokens. Streaming clients receive the completed answer in an SSE response.</p></details></section>\n<details class=\"api-section advanced\"><summary>Existing API keys and address settings</summary><div class=\"advanced-content\"><h3>Keep existing clients working</h3><p class=\"hint\">Old gateway keys remain saved. They gain remote access only after you explicitly allow them here. Removing their remote access preserves their original local gateway permissions.</p><div id=\"legacy-keys\" class=\"key-list\"></div><hr><h3>Replace your remote address</h3><p class=\"hint\">Keep your existing relay identity by default. Replacing it stops access and makes old base URLs invalid; keys stay saved.</p><button class=\"danger\" id=\"rotate\" type=\"button\">Review address replacement</button></div></details>\n</div></main><script src=\"kai-notices.js\"></script><script src=\"app.js\"></script></body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","style.css":"/* The original Local API settings composition in a separate KAI window. */\n:root{color-scheme:light;--bg:#f4f7fd;--panel:#fff;--line:#dce5f2;--text:#14284e;--muted:#61728d;--accent:#155eef;--danger:#c93d4c;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}*{box-sizing:border-box}body{margin:0;height:100dvh;min-height:500px;display:flex;flex-direction:column;overflow:hidden}button,input,select{font:inherit}button{background:#fff;color:var(--text);border:1px solid var(--line);border-radius:9px;padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}button.primary:hover:not(:disabled){background:#0c4ed3}button.danger{color:var(--danger)}button:disabled{opacity:.5;cursor:not-allowed}:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.workspace-header{display:flex;align-items:center;gap:11px;height:74px;min-height:74px;padding:0 34px;border-bottom:1px solid var(--line)}.workspace-header h1{font-size:15px;font-weight:650;margin:0}.workspace-header svg{width:20px;height:20px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-caption{margin-left:auto;color:var(--muted);font-size:10px}main{flex:1;min-height:0;overflow:auto;padding:30px 34px 50px}.api-card{max-width:940px;margin:0 auto;width:100%}.page-heading{margin-bottom:28px}.page-heading h2{font-size:29px;font-weight:650;letter-spacing:-.9px;line-height:1.3;margin:0 0 10px}.lead{font-size:13px;line-height:1.8;color:var(--muted);margin:0;max-width:720px}.api-section{margin:0;padding:23px 0;border-top:1px solid var(--line)}h3{font-size:17px;font-weight:650;letter-spacing:-.3px;line-height:1.4;margin:0 0 14px}.keys-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.keys-head h3{margin:0}.hint{color:var(--muted);font-size:12px;line-height:1.75;margin:0 0 14px}.form-row{display:flex;align-items:center;gap:10px;margin:18px 0 10px}.form-row input{flex:1}.form-row button{flex:none}label{display:block;font-size:12px;color:var(--muted);margin:0 0 7px}input,select{width:100%;min-width:0;border:1px solid var(--line);border-radius:9px;padding:11px 13px;background:#f5f8fe;color:var(--text);font-size:12px}select{max-width:440px;margin:0 0 9px}input::placeholder{color:#8795aa}.key-list{display:grid;gap:9px;margin-top:17px}.card{background:#fff;border:1px solid var(--line);border-radius:11px;padding:14px 16px;min-width:0;overflow-wrap:anywhere}.spread{display:flex;justify-content:space-between;align-items:center;gap:14px}.card h3{font-size:12px;margin:0 0 4px}.card small{font-size:10px;color:var(--muted)}.card button{font-size:11px;padding:7px 10px}.empty{font-size:12px;color:var(--muted);margin:0;padding:12px 0}.switch-controls{display:flex;align-items:center}.switch{display:inline-flex;align-items:center;gap:9px;min-height:36px;padding:3px 0 3px 5px;background:transparent;border:0;font-size:11px;color:var(--muted)}.switch:hover:not(:disabled){background:transparent}.switch-track{position:relative;display:inline-block;width:36px;height:21px;background:#d4dfec;border:1px solid #bac9da;border-radius:99px;flex:none;transition:background .15s}.switch-thumb{position:absolute;width:13px;height:13px;left:3px;top:3px;border-radius:50%;background:#fff;box-shadow:0 1px 3px #17355325;transition:transform .15s}.switch[aria-checked=true] .switch-track{background:var(--accent);border-color:var(--accent)}.switch[aria-checked=true] .switch-thumb{transform:translateX(15px)}.connection-status{display:flex;gap:13px;align-items:flex-start;margin:19px 0 22px;padding:17px 18px;border:1px solid var(--line);background:#fff;border-radius:12px}.connection-status>div{flex:1;min-width:0}.connection-status strong{display:block;font-size:12px;font-weight:600;margin:1px 0 5px}.connection-status .hint{margin:0;font-size:11px}.connection-status>button{flex:none;font-size:11px;padding:7px 10px}.pill{display:inline-block;border:1px solid #d5e4fc;border-radius:30px;padding:4px 9px;background:#f5f9ff;color:var(--muted);font-size:10px;white-space:nowrap;text-transform:capitalize}.pill.connected{background:#eaf7f0;border-color:#bedfce;color:#107651}.endpoint{display:flex;gap:10px;align-items:end;margin-bottom:10px}.endpoint label{flex:1;min-width:0;margin:0}.endpoint input{font:12px/1.6 Consolas,ui-monospace,monospace;margin-top:8px}.endpoint button{flex:none;min-height:41px}.relay-note{font-size:11px;line-height:1.7;color:var(--muted);margin:12px 0 0}.advanced summary{cursor:pointer;color:var(--text);font-size:12px;font-weight:550;line-height:1.6}.advanced-content{padding-top:20px}.advanced>p{margin-top:15px}.advanced h3{font-size:14px}.advanced .advanced-content h3:not(:first-child){margin-top:16px}hr{border:0;border-top:1px solid var(--line);margin:23px 0}#notice{padding:11px 14px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;margin:0 0 20px;font-size:12px;overflow-wrap:anywhere}#notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}@media(max-width:750px){main{padding:24px 22px 40px}.workspace-header{padding:0 22px}.page-heading h2{font-size:26px}.connection-status{flex-wrap:wrap}.connection-status>button{margin-left:auto}}@media(max-width:520px){main{padding:22px 16px 35px}.workspace-header{height:65px;min-height:65px;padding:0 16px}.page-heading h2{font-size:24px}.endpoint,.form-row{align-items:stretch;flex-direction:column}.form-row button{align-self:flex-start}.card.spread{align-items:flex-start;flex-wrap:wrap}.connection-status>div{flex-basis:70%}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"9wMpIzX4/UuF7XBI7zioDZtyKcd03x1PWBawBhhrMqwlcNffOGNebGDzwLPZeUy8zCktNPL8L+gm3CYgLTOUCg=="}