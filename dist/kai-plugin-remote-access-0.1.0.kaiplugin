{"manifest":{"schema":1,"apiVersion":2,"id":"kai.remote-access","name":"KAI Remote Access","version":"0.1.0","description":"Connect trusted clients to your local models through a reviewed, authenticated relay session.","entry":"index.html","permissions":["remote-access.read","remote-access.control","remote-access.keys"]},"files":{"app.js":"\"use strict\";\nconst $=id=>document.getElementById(id);let state=null,busy=false;\nfunction notice(message,error=false){$(\"notice\").hidden=false;$(\"notice\").textContent=message;$(\"notice\").className=error?\"error\":\"\";}\nfunction node(tag,text,className){const el=document.createElement(tag);if(text!==undefined)el.textContent=text;if(className)el.className=className;return el;}\nfunction keyCard(key,legacy=false){const card=node(\"div\",undefined,\"card spread\"),info=node(\"div\");info.append(node(\"h3\",key.name));info.append(node(\"small\",legacy?(key.enabled?\"Allowed for remote access\":\"Not allowed remotely\"):\"Remote text inference only\"));const button=node(\"button\",legacy?(key.enabled?\"Remove remote access\":\"Allow remotely\"):\"Revoke\",legacy?\"\":\"danger\");button.disabled=busy;button.addEventListener(\"click\",()=>act(legacy?\"remote.keyAdopt\":\"remote.keyRevoke\",legacy?{id:key.id,enabled:!key.enabled}:{id:key.id},legacy?\"Remote key permissions updated. Start access again when ready.\":\"Key revoked. Remote Access stopped.\"));card.append(info,button);return card;}\nfunction render(){if(!state)return;$(\"privacy\").textContent=state.privacyMode;$(\"state\").textContent=state.state;$(\"headline\").textContent=({off:\"Open a connection when you need it.\",connecting:\"Connecting to your relay…\",connected:\"Your local models are available.\",offline:\"The relay is currently unavailable.\"})[state.state]||\"Remote Access\";$(\"connection-detail\").textContent=state.state===\"offline\"?\"KAI will retry while this window stays open. You can stop at any time.\":state.enabled?\"Only holders of enabled API keys can use the endpoints shown here.\":\"Create or allow a key, then review the connection before starting.\";$(\"endpoint\").value=state.base||\"\";$(\"start\").disabled=busy||state.enabled;$(\"stop\").disabled=!state.enabled;$(\"copy-endpoint\").disabled=busy||!state.base;$(\"key-create\").disabled=busy;$(\"rotate\").disabled=busy;$(\"refresh\").disabled=busy;$(\"counts\").textContent=`${state.counts.served} served · ${state.counts.rejected} rejected this session`;\nconst keys=$(\"keys\");keys.replaceChildren(...state.keys.map(k=>keyCard(k)));if(!state.keys.length)keys.append(node(\"p\",\"No remote keys yet.\",\"empty\"));const legacy=$(\"legacy-keys\");legacy.replaceChildren(...state.legacyKeys.map(k=>keyCard(k,true)));if(!state.legacyKeys.length)legacy.append(node(\"p\",\"No existing gateway keys were found.\",\"empty\"));$(\"models\").replaceChildren(...state.models.map(m=>{const el=node(\"option\",m.label||m.alias);el.value=m.alias;return el;}));$(\"model-note\").textContent=state.models.length?\"Use the selected model’s API name: \"+$(\"models\").value:\"Install a local model from Core’s Models section before starting.\";}\nasync function refresh(){state=await window.kai.call(\"remote.status\",{});render();}\nasync function act(method,input={},success){if(busy)return;busy=true;render();try{const result=await window.kai.call(method,input);if(result.cancelled)notice(\"Canceled. No change was made.\");else if(success)notice(success);await refresh();}catch(error){notice(error.message||\"This action could not complete.\",true);}finally{busy=false;render();}}\n$(\"refresh\").addEventListener(\"click\",()=>act(\"remote.status\"));$(\"start\").addEventListener(\"click\",()=>act(\"remote.start\",{},\"Connecting. The base URL appears after the relay confirms your address.\"));$(\"stop\").addEventListener(\"click\",async()=>{try{await window.kai.call(\"remote.stop\",{});await refresh();notice(\"Remote Access stopped.\");}catch(e){notice(e.message,true);}});$(\"rotate\").addEventListener(\"click\",()=>act(\"remote.rotate\",{},\"Address identity replaced. Start access again to obtain your new URL.\"));$(\"copy-endpoint\").addEventListener(\"click\",()=>act(\"remote.copyEndpoint\",{},\"Base URL copied.\"));$(\"key-form\").addEventListener(\"submit\",event=>{event.preventDefault();act(\"remote.keyCreate\",{name:$(\"key-name\").value.trim()},\"Key copied by Core. Paste it into your trusted client now; the clipboard clears after 60 seconds if unchanged.\");});$(\"models\").addEventListener(\"change\",()=>{$(\"model-note\").textContent=\"Use this model’s API name: \"+$(\"models\").value;});\nrefresh().catch(e=>notice(e.message,true));setInterval(()=>{if(!busy)refresh().catch(e=>notice(e.message,true));},3000);\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'\"><title>KAI Remote Access</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><main>\n<header><div><div class=\"eyebrow\">KAI / Remote Access</div><h1>Your models. Wherever you work.</h1><p class=\"lead\">Give trusted apps access to local text inference. You choose the keys, and decide when your computer is available.</p></div><span class=\"pill\" id=\"privacy\">Connecting to Core</span></header>\n<div id=\"notice\" role=\"status\" aria-live=\"polite\" hidden></div>\n<section class=\"panel\"><div class=\"spread\"><div><span class=\"eyebrow\" id=\"state\">Off</span><h2 id=\"headline\">Open a connection when you need it.</h2><p class=\"muted\" id=\"connection-detail\">Remote Access never starts automatically.</p></div><button id=\"refresh\">Refresh</button></div><div class=\"actions\"><button class=\"primary\" id=\"start\">Review and start</button><button id=\"stop\" disabled>Stop access</button><span class=\"muted\" id=\"counts\">No requests served this session.</span></div><div class=\"endpoint\"><label>OpenAI-compatible base URL<input id=\"endpoint\" readonly placeholder=\"Appears after connecting\"></label><button id=\"copy-endpoint\" disabled>Copy URL</button></div><p class=\"mini muted\">Keep this window open while you use remote clients. Closing it or switching Core to Local-Only stops access.</p></section>\n<div class=\"grid\"><section class=\"panel\"><h2>Keys for trusted clients</h2><p class=\"muted\">Each key can list installed models and request local text inference while access is on. Revoke a key whenever you need to.</p><form class=\"stack\" id=\"key-form\"><label>Key name<input id=\"key-name\" maxlength=\"80\" required placeholder=\"My laptop\"></label><button class=\"primary\" id=\"key-create\" type=\"submit\">Create and copy key</button></form><p class=\"mini muted\">Core copies the secret once. Save it in your client within 60 seconds; the plugin never receives it.</p><div id=\"keys\" class=\"stack\"></div></section><section class=\"panel\"><h2>Connect a client</h2><ol><li>Create a remote key and paste it into the client’s API key field.</li><li>Choose an online privacy mode in Core, then start Remote Access.</li><li>Copy the base URL and choose one of your available models.</li></ol><label>Available local models<select id=\"models\"></select></label><p class=\"mini muted\" id=\"model-note\"></p><div class=\"note\">The relay at koinosai.com receives client API keys, prompts and responses. Give keys only to trusted clients.</div><p class=\"muted\">Text chat only. Up to 16,000 characters of conversation and 4,096 output tokens. Streaming clients receive the completed answer in an SSE response.</p></section></div>\n<details class=\"panel\"><summary>Existing API keys and address settings</summary><h2>Keep existing clients working</h2><p class=\"muted\">Old gateway keys remain saved. They gain remote access only after you explicitly allow them here. Removing their remote access preserves their original local gateway permissions.</p><div id=\"legacy-keys\" class=\"stack\"></div><hr><h2>Replace your remote address</h2><p class=\"muted\">Keep your existing relay identity by default. Replacing it stops access and makes old base URLs invalid; keys stay saved.</p><button class=\"danger\" id=\"rotate\">Review address replacement</button></details>\n<footer>KAI Remote Access 0.1.0 · Requires KAI Core 0.3.0 · No wallet, Brain, account, file, or paid inference access.</footer>\n</main><script src=\"app.js\"></script></body></html>\n","style.css":":root{color-scheme:dark;--bg:#10151c;--panel:#19222d;--line:#2c3948;--text:#e8edf3;--muted:#9fafc0;--accent:#82dec4;--danger:#ffb3ac;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-size:14px;line-height:1.55}main{max-width:1220px;margin:auto;padding:38px 38px 70px}header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:30px}.eyebrow{text-transform:uppercase;color:var(--accent);font-size:11px;letter-spacing:.17em;font-weight:700}h1{font-size:32px;letter-spacing:-.035em;line-height:1.2;margin:8px 0 12px}h2{font-size:19px;margin:0 0 8px}h3{font-size:16px;margin:0 0 5px}p{margin:0 0 14px}.muted,small{color:var(--muted)}.lead{max-width:640px;color:var(--muted)}.pill{border:1px solid var(--line);padding:6px 11px;border-radius:30px;font-size:12px;white-space:nowrap;color:var(--accent)}nav{display:flex;gap:7px;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:24px;overflow:auto}button{font:inherit;font-weight:600;background:#253343;color:var(--text);border:1px solid #394c60;border-radius:9px;padding:9px 14px;cursor:pointer}button:hover{background:#35495e}button.primary{background:var(--accent);color:#102620;border-color:var(--accent)}button.primary:hover{background:#a3efd9}button.danger{color:var(--danger)}button:disabled{opacity:.5;cursor:wait}nav button{border-color:transparent;background:transparent;color:var(--muted)}nav button[aria-selected=\"true\"]{background:#223930;color:var(--accent)}:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;margin-bottom:20px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:14px}.card{border:1px solid var(--line);border-radius:12px;padding:20px;background:#17202a;min-width:0;overflow-wrap:anywhere}.card .actions{margin-top:18px}.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.spread{display:flex;justify-content:space-between;gap:12px;align-items:start}.stack{display:grid;gap:15px}label{display:grid;gap:6px;color:var(--muted);font-size:13px}label.check{display:flex;align-items:start;gap:9px}input,select,textarea{font:inherit;color:var(--text);border:1px solid #3a4b60;background:#111923;border-radius:8px;padding:10px;width:100%;min-width:0}input[type=\"checkbox\"]{width:17px;height:17px;accent-color:var(--accent);flex:none;margin-top:2px}textarea{resize:vertical;min-height:100px;font-family:ui-monospace,monospace;font-size:12px}pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:460px;overflow:auto;background:#111923;border:1px solid var(--line);border-radius:9px;padding:16px;font-size:12px;margin:12px 0 0}#notice{padding:12px 16px;margin:0 0 20px;border:1px solid #3d796a;border-radius:10px;background:#17312b;overflow-wrap:anywhere}#notice.error{border-color:#8c4c46;background:#39221f;color:#ffd1cc}.empty{color:var(--muted);border:1px dashed var(--line);padding:30px;border-radius:12px;text-align:center}.note{border-left:3px solid var(--accent);padding:8px 14px;color:var(--muted);font-size:13px;margin:14px 0}.mini{font-size:12px;margin-top:5px}.tool-list{display:grid;gap:10px;margin:15px 0;max-height:360px;overflow:auto}.tool-list label{border:1px solid var(--line);border-radius:8px;padding:11px}.status{font-size:12px;color:var(--accent)}.count{font-size:28px;font-weight:600;color:var(--accent)}[hidden]{display:none!important}details summary{cursor:pointer;color:var(--muted);margin:14px 0}footer{color:var(--muted);font-size:12px;margin-top:30px}@media(max-width:750px){main{padding:24px 18px}.grid{grid-template-columns:1fr}header{align-items:start}h1{font-size:27px}.panel{padding:18px}}\n.runtime{margin-top:20px}\n.endpoint{display:flex;gap:12px;align-items:end;margin-top:24px}.endpoint label{flex:1}.endpoint input{font-family:ui-monospace,monospace;font-size:12px}#keys{margin-top:20px}ol{padding-left:22px;color:var(--muted)}li{margin-bottom:14px}hr{border:0;border-top:1px solid var(--line);margin:25px 0}.card h3{font-size:14px}#state{display:block;margin-bottom:8px}@media(max-width:600px){.endpoint{align-items:stretch;flex-direction:column}.card.spread{flex-direction:column}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"Kxel0bPyvQDoTifH0vvjfXN1vP9QTcstbd9B8guUL0tnwqzk8WQB3fBSx7S2ckddcWSJZeqQrGwYITrqpt50Aw=="}